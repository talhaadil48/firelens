{
  "openapi": "3.1.0",
  "info": {
    "title": "FireLens contract API",
    "description": "Phase 2 offline fixtures. Real NASA metadata; no validated scientific outputs.",
    "version": "0.1.0"
  },
  "paths": {
    "/meta": {
      "get": {
        "summary": "Meta",
        "operationId": "meta_meta_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/profiles": {
      "get": {
        "summary": "Profiles",
        "operationId": "profiles_profiles_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileConfig"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/investigations": {
      "get": {
        "summary": "List Investigations",
        "operationId": "list_investigations_investigations_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvestigationList"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/investigations/{accession}": {
      "get": {
        "summary": "Investigation",
        "operationId": "investigation_investigations__accession__get",
        "parameters": [
          {
            "name": "accession",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Accession"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Investigation"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/rank": {
      "get": {
        "summary": "Rank",
        "operationId": "rank_rank_get",
        "parameters": [
          {
            "name": "profile",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "iss",
              "title": "Profile"
            }
          },
          {
            "name": "oxygen_fraction",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 1,
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Oxygen Fraction"
            }
          },
          {
            "name": "pressure_kpa",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Pressure Kpa"
            }
          },
          {
            "name": "flow_cm_s",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Flow Cm S"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RankResponse"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/tests": {
      "get": {
        "summary": "Tests",
        "operationId": "tests_tests_get",
        "parameters": [
          {
            "name": "accession",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Accession"
            }
          },
          {
            "name": "oxygen_min",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 1,
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Oxygen Min"
            }
          },
          {
            "name": "oxygen_max",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 1,
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Oxygen Max"
            }
          },
          {
            "name": "pressure_min",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Pressure Min"
            }
          },
          {
            "name": "pressure_max",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Pressure Max"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestList"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/compare": {
      "get": {
        "summary": "Compare",
        "operationId": "compare_compare_get",
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ids"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompareResponse"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/export": {
      "get": {
        "summary": "Export",
        "operationId": "export_export_get",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(csv|json)$",
              "default": "csv",
              "title": "Format"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExportResponse"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/chat": {
      "post": {
        "summary": "Chat",
        "operationId": "chat_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "SSE: progress, answer, done. See docs/contracts/sse.md for event payloads.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "x-sse-events": {
          "progress": {
            "$ref": "#/components/schemas/ProgressEvent"
          },
          "answer": {
            "$ref": "#/components/schemas/AnswerEvent"
          },
          "done": {
            "$ref": "#/components/schemas/DoneEvent"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Question"
          },
          "investigation_ids": {
            "items": {
              "type": "string",
              "pattern": "^PSI-\\d+$"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Investigation Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "ChatRequest"
      },
      "Citation": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "accession": {
            "pattern": "^PSI-\\d+$",
            "title": "Accession",
            "type": "string"
          },
          "locator": {
            "minLength": 1,
            "title": "Locator",
            "type": "string"
          },
          "supporting_text": {
            "minLength": 1,
            "title": "Supporting Text",
            "type": "string"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          }
        },
        "required": [
          "id",
          "accession",
          "locator",
          "supporting_text",
          "provenance"
        ],
        "title": "Citation",
        "type": "object"
      },
      "CompareResponse": {
        "properties": {
          "investigations": {
            "items": {
              "$ref": "#/components/schemas/Investigation"
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 2,
            "title": "Investigations"
          },
          "same": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Same"
          },
          "different": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Different"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "mode": {
            "type": "string",
            "const": "mock",
            "title": "Mode",
            "default": "mock"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "investigations",
          "same",
          "different",
          "summary",
          "warnings"
        ],
        "title": "CompareResponse"
      },
      "ConditionRange": {
        "properties": {
          "minimum": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Minimum"
          },
          "maximum": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Maximum"
          },
          "unit": {
            "type": "string",
            "enum": [
              "fraction",
              "kPa",
              "cm/s"
            ],
            "title": "Unit"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "unit"
        ],
        "title": "ConditionRange"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "EvidenceType": {
        "type": "string",
        "enum": [
          "measurement",
          "simulation",
          "author_interpretation",
          "metadata",
          "mock"
        ],
        "title": "EvidenceType"
      },
      "ExperimentalTest": {
        "properties": {
          "test_id": {
            "type": "string",
            "minLength": 1,
            "title": "Test Id"
          },
          "accession": {
            "type": "string",
            "pattern": "^PSI-\\d+$",
            "title": "Accession"
          },
          "campaign_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Campaign Id"
          },
          "material": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Material"
          },
          "fuel_phase": {
            "type": "string",
            "enum": [
              "solid",
              "liquid",
              "gas",
              "mixed",
              "unknown"
            ],
            "title": "Fuel Phase",
            "default": "unknown"
          },
          "geometry": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Geometry"
          },
          "thickness_mm": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Thickness Mm"
          },
          "oxygen_fraction": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Oxygen Fraction"
          },
          "oxygen_basis": {
            "type": "string",
            "enum": [
              "mole",
              "volume",
              "mass",
              "unknown"
            ],
            "title": "Oxygen Basis",
            "default": "unknown"
          },
          "pressure_kpa": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Pressure Kpa"
          },
          "flow_cm_s": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Flow Cm S"
          },
          "flow_direction": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Flow Direction"
          },
          "gravity": {
            "$ref": "#/components/schemas/Gravity",
            "default": "unknown"
          },
          "platform": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Platform"
          },
          "outcome": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Outcome"
          },
          "outcome_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Outcome Value"
          },
          "outcome_unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Outcome Unit"
          },
          "baseline_test_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline Test Id"
          },
          "evidence_type": {
            "$ref": "#/components/schemas/EvidenceType"
          },
          "review_status": {
            "$ref": "#/components/schemas/ReviewStatus",
            "default": "unreviewed"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Notes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "test_id",
          "accession",
          "evidence_type",
          "provenance"
        ],
        "title": "ExperimentalTest"
      },
      "ExportResponse": {
        "properties": {
          "format": {
            "type": "string",
            "const": "json",
            "title": "Format",
            "default": "json"
          },
          "source_credit": {
            "type": "string",
            "title": "Source Credit"
          },
          "mode": {
            "type": "string",
            "const": "mock",
            "title": "Mode",
            "default": "mock"
          },
          "tests": {
            "items": {
              "$ref": "#/components/schemas/ExperimentalTest"
            },
            "type": "array",
            "title": "Tests"
          },
          "investigations": {
            "items": {
              "$ref": "#/components/schemas/Investigation"
            },
            "type": "array",
            "title": "Investigations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_credit",
          "tests",
          "investigations"
        ],
        "title": "ExportResponse"
      },
      "Finding": {
        "properties": {
          "claim": {
            "type": "string",
            "title": "Claim"
          },
          "evidence_type": {
            "$ref": "#/components/schemas/EvidenceType"
          },
          "citation_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Citation Ids"
          },
          "review_status": {
            "$ref": "#/components/schemas/ReviewStatus",
            "default": "unreviewed"
          },
          "uncertainty_label": {
            "type": "string",
            "enum": [
              "not_assessed",
              "reported",
              "not_reported",
              "qualitative"
            ],
            "title": "Uncertainty Label",
            "default": "not_assessed"
          },
          "uncertainty_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Uncertainty Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "claim",
          "evidence_type",
          "citation_ids"
        ],
        "title": "Finding"
      },
      "Gravity": {
        "type": "string",
        "enum": [
          "normal_gravity",
          "microgravity",
          "reduced_gravity",
          "simulated",
          "unknown"
        ],
        "title": "Gravity"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Investigation": {
        "properties": {
          "accession": {
            "type": "string",
            "pattern": "^PSI-\\d+$",
            "title": "Accession"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "acronym": {
