# FireLens Azure settings. Copy to infra/.env.azure (git-ignored) and edit.
# Names marked GLOBAL must be unique across all of Azure: change the suffix if taken.
# No secrets here. The OpenRouter key is read from $OPENROUTER_API_KEY or ./.env.

SUBSCRIPTION=                    # subscription id; empty = the current `az account show`
LOCATION=eastus2
RG=firelens-rg

# Monitoring (build-steps 9.1)
LOGS=firelens-logs
APPINSIGHTS=firelens-insights

# Snapshots (9.2). GLOBAL: 3-24 lowercase letters/digits, no dashes.
STORAGE=firelensdata1411
CONTAINER=snapshots

# LLM (replaces 9.3 Azure OpenAI). Any OpenRouter chat model id.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Container Apps (9.4, 9.5). `provision.sh image` pushes API_IMAGE; make it public once.
# Lowercase only. Until main has the Phase 6+ API, push to your own GitHub namespace;
# switch to ghcr.io/talhaadil48/firelens-api:latest once the Deploy API workflow runs.
ENV_NAME=firelens-env
API_APP=firelens-api
API_IMAGE=ghcr.io/qambar-12/firelens-api:latest
# JSON list. Empty = the Static Web App URL + localhost. Set to the custom domain at go-live.
CORS_ORIGINS=

# Static Web App (9.6). Free plan regions: westus2, centralus, eastus2, westeurope, eastasia.
WEB_APP=firelens-web
WEB_LOCATION=eastus2
# API URL baked into the web build by `provision.sh web`. Empty = the Container App URL.
# Set to https://api.<domain> at go-live.
WEB_API_URL=

# GitHub deploys (Phase 10)
GITHUB_REPO=talhaadil48/firelens
DEPLOY_APP=firelens-github-deploy   # Entra app used by Actions through OIDC

# Budget alert (9.7)
BUDGET_AMOUNT=20
BUDGET_EMAIL=
