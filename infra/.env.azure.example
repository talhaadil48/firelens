# FireLens Azure settings. Copy to infra/.env.azure (git-ignored) and edit.
# Names marked GLOBAL must be unique across all of Azure: change the suffix if taken.

LOCATION=eastus2                 # a region where `provision.sh check` lists both models
RG=firelens-rg

# Monitoring (build-steps 9.1)
LOGS=firelens-logs
APPINSIGHTS=firelens-insights

# Snapshots (9.2). GLOBAL: 3-24 lowercase letters/digits, no dashes.
STORAGE=firelensdata1411
CONTAINER=snapshots

# Azure OpenAI (9.3). GLOBAL: becomes https://<AOAI>.openai.azure.com
AOAI=firelens-aoai-1411
OPENAI_API_VERSION=2024-10-21
CHAT_DEPLOYMENT=chat
CHAT_MODEL=gpt-4.1-mini
CHAT_MODEL_VERSION=2025-04-14    # use a version `check` lists for your region
CHAT_SKU=GlobalStandard          # or Standard / DataZoneStandard, as `check` lists
CHAT_CAPACITY=50                 # thousands of tokens per minute
EMBED_DEPLOYMENT=embed
EMBED_MODEL=text-embedding-3-small
EMBED_MODEL_VERSION=1
EMBED_SKU=Standard               # or GlobalStandard, as `check` lists
EMBED_CAPACITY=100

# Container Apps (9.4, 9.5). The image must exist in GHCR first (Phase 10 workflow).
ENV_NAME=firelens-env
API_APP=firelens-api
API_IMAGE=ghcr.io/talhaadil48/firelens-api:latest
# JSON list. Start with the Static Web App URL; switch to https://www.<domain> at go-live.
CORS_ORIGINS='["http://localhost:5173"]'   # keep the single quotes

# Static Web App (9.6). Free plan regions: westus2, centralus, eastus2, westeurope, eastasia.
WEB_APP=firelens-web
WEB_LOCATION=eastus2

# GitHub repo that receives the deploy secrets (`provision.sh secrets`).
GITHUB_REPO=talhaadil48/firelens
