# mock = Phase 2 fixtures; snapshot = snapshots/latest.json (run `make harvest snapshot` first).
FIRELENS_MODE=mock
FIRELENS_SNAPSHOT_DIR=snapshots
# Local development only: include rows from column maps nobody has reviewed yet.
FIRELENS_ALLOW_UNREVIEWED=false
# Cached hourly PSI catalogue check behind /meta (snapshot mode only).
FIRELENS_PSI_CHECK=true
# Model provider for summaries, embeddings and chat: mock | azure | openai
FIRELENS_LLM_PROVIDER=mock
FIRELENS_CORS_ORIGINS=["http://localhost:5173"]
PSI_BASE_URL=https://psi.nasa.gov
# Later phases only. Never put secrets in VITE_* variables.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Fallback OpenAI-compatible provider (FIRELENS_LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=snapshots
