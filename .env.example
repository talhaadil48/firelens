# Set FIRELENS_MODE=snapshot to serve normalized data from snapshots/latest.json
FIRELENS_MODE=mock
FIRELENS_CORS_ORIGINS=["http://localhost:5173"]
PSI_BASE_URL=https://psi.nasa.gov
# LLM provider: auto | openrouter | azure | offline (never put secrets in VITE_* variables)
LLM_PROVIDER=auto
# Option 1: OpenRouter (recommended quick local setup)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Option 2: Azure OpenAI / OpenAI-compatible
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=snapshots
